#!/usr/bin/env bash
# Fake `npm` for bite (3): returns a real-looking version, but a GitHub
# Packages tarball URL — proves check_host fires through the PRODUCTION
# line (not a direct function call). PATH-shim only; never installs, never
# touches a real registry.
if [ "$1" = "view" ] && [[ "$*" == *"version"* ]]; then
  echo "99.99.99-fake"
  exit 0
fi
if [ "$1" = "view" ] && [[ "$*" == *"dist.tarball"* ]]; then
  echo "https://npm.pkg.github.com/download/@3fn/core/99.99.99-fake/abcd1234.tgz"
  exit 0
fi
echo "fake-npm: unhandled invocation: $*" >&2
exit 1
