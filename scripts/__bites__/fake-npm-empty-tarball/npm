#!/usr/bin/env bash
# Fake `npm` for the empty-URL branch (exit 13): version check succeeds,
# but the tarball-URL query returns nothing — simulates a network/registry
# error on the second call under `set -e` command-substitution semantics.
# PATH-shim only; never installs, never touches a real registry.
if [ "$1" = "view" ] && [[ "$*" == *"version"* ]]; then
  echo "99.99.99-fake"
  exit 0
fi
if [ "$1" = "view" ] && [[ "$*" == *"dist.tarball"* ]]; then
  echo ""
  exit 0
fi
echo "fake-npm: unhandled invocation: $*" >&2
exit 1
