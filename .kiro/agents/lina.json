      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      }
    ]
  },
  "includeMcpJson": true,
  "keyboardShortcut": "ctrl+shift+l",
  "name": "lina",
  "prompt": "file://./lina-prompt.md",
  "resources": [
    "file://.kiro/steering/Agent-Directory.md",
