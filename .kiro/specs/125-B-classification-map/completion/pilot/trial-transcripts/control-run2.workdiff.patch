+  // ============================================================================
+  // Alt-Required Warning Matrix (settled edge semantics)
+  //
+  // The warn fires iff: type === 'human' && src && alt is absent && !decorative.
+  //
+  // @see .kiro/specs/126-avatar-decorative-warn/design-outline.md § 4 (option O2,
+  //      ratified by Peter 2026-07-09) and § 5 for this six-case matrix.
+  // @see Requirements: 5.4 (human + src requires alt), 5 AC 5 (agent ignores src),
+  //      9.2 (decorative → aria-hidden) in .kiro/specs/042-avatar-component/requirements.md
+  // ============================================================================
+
+  describe('Alt-Required Warning Matrix', () => {
+    let consoleSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+      consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+    });
+
+    afterEach(() => {
       consoleSpy.mockRestore();
     });
+
+    it('should warn for human type with src and no alt', async () => {
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).toHaveBeenCalledWith(expect.stringContaining('"alt" is required'));
+    });
+
+    it('should NOT warn for human type with an explicitly empty alt attribute', async () => {
+      // setAttribute is the only path to a genuinely empty alt — the HTML-idiomatic
+      // signal that the image is decorative. Treated as intent.
