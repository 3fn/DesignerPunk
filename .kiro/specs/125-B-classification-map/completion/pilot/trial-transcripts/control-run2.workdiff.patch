+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.setAttribute('alt', '');
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(avatar.alt).toBe('');
+      expect(consoleSpy).not.toHaveBeenCalled();
+    });
+
+    it('should warn for human type when the alt property is set to an empty string', async () => {
+      // The `alt` setter removes the attribute on a falsy value, so the property form
+      // collapses to absent. Pinned explicitly: this lands in the "no alt" bucket and warns.
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.alt = '';
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(avatar.alt).toBeNull();
+      expect(consoleSpy).toHaveBeenCalledWith(expect.stringContaining('"alt" is required'));
+
+      // The rendered image still carries alt="" (Req 9.1 render path, unchanged).
+      const img = avatar.shadowRoot?.querySelector('.avatar__image');
+      expect(img?.getAttribute('alt')).toBe('');
+    });
+
+    it('should NOT warn for a decorative human avatar, which is aria-hidden', async () => {
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.decorative = true;
+      // No alt provided
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).not.toHaveBeenCalled();
