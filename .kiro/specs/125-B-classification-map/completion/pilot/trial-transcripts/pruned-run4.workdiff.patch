+
+  // ============================================================================
+  // Alt Text Warning — Settled Edge Semantics
+  // ============================================================================
+
+  /**
+   * The warn fires iff: type === 'human' && src && alt == null && !decorative.
+   *
+   * Row 1 of the matrix (human + src + alt absent → warns) is the existing
+   * 'should warn when src is provided without alt' test above, unchanged. The five
+   * rows below complete it.
+   *
+   * @see .kiro/specs/126-avatar-decorative-warn/design-outline.md (option O2, ratified)
+   * @see Requirements: 5.4 (human + src requires alt), 5 AC 5 (agent ignores src), 9.2 (decorative)
+   */
+  describe('Alt Text Warning — Settled Edge Semantics', () => {
+    it('should NOT warn when alt is an explicit empty-string attribute', async () => {
+      const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      // Raw attribute form — the only path that yields a real empty-string alt
+      avatar.setAttribute('alt', '');
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(avatar.alt).toBe('');
+      expect(consoleSpy).not.toHaveBeenCalled();
+
+      consoleSpy.mockRestore();
+    });
+
+    it('should warn when alt is set to empty string via the property (collapses to absent)', async () => {
+      const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      // Property setter removes the attribute on a falsy value → alt is absent, not ''
+      avatar.alt = '';
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      // Pin the collapse: the property form is indistinguishable from omitting alt
+      expect(avatar.getAttribute('alt')).toBeNull();
+      expect(consoleSpy).toHaveBeenCalledWith(expect.stringContaining('alt'));
+
+      // Render output is unaffected by the collapse — the img still gets alt=""
+      const img = avatar.shadowRoot?.querySelector('.avatar__image');
+      expect(img?.getAttribute('alt')).toBe('');
+
+      consoleSpy.mockRestore();
+    });
+
+    it('should NOT warn for a decorative avatar, which is hidden from screen readers', async () => {
+      const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.decorative = true;
+      // No alt — decorative is the official non-informative signal
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).not.toHaveBeenCalled();
+
+      // Co-assert WHY the warn is correctly suppressed: nothing is announced (Req 9.2)
+      const container = avatar.shadowRoot?.querySelector('.avatar');
+      expect(container?.getAttribute('aria-hidden')).toBe('true');
+
+      consoleSpy.mockRestore();
+    });
+
+    it('should NOT warn for an agent avatar with src and no alt (src is ignored)', async () => {
+      const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'agent';
+      avatar.src = 'https://example.com/agent.jpg';
+      // No alt — agent type ignores src entirely (Req 5 AC 5), so there is no image to describe
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).not.toHaveBeenCalled();
+
+      consoleSpy.mockRestore();
+    });
+
+    it('should NOT warn for an agent avatar with src and alt (silencing is type-driven)', async () => {
+      const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'agent';
+      avatar.src = 'https://example.com/agent.jpg';
+      avatar.alt = 'Agent profile';
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).not.toHaveBeenCalled();
+
       consoleSpy.mockRestore();
     });
   });
