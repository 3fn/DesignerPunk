+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.setAttribute('alt', '');
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(avatar.alt).toBe('');
+      expect(consoleSpy).not.toHaveBeenCalled();
+    });
+
+    it('should warn when alt is set to empty string via the property setter', async () => {
+      // The setter treats '' as falsy and removes the attribute, so this collapses to the
+      // alt-absent path and correctly warns. Pinned so the collapse cannot regress silently.
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.alt = '';
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(avatar.alt).toBeNull();
+      expect(consoleSpy).toHaveBeenCalledTimes(1);
+
+      // The rendered image still carries alt="" on this path.
+      const img = avatar.shadowRoot?.querySelector('.avatar__image');
+      expect(img?.getAttribute('alt')).toBe('');
+    });
+
+    it('should NOT warn when a human avatar with src is decorative', async () => {
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      avatar.decorative = true;
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).not.toHaveBeenCalled();
+
+      // Co-asserted: the warn is suppressed because the avatar genuinely is hidden from
+      // screen readers, not merely because the condition happens to be false.
+      const container = avatar.shadowRoot?.querySelector('.avatar');
