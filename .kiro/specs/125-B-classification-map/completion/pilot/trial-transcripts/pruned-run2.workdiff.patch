+  // ============================================================================
+  // Alt Warning Behavior (settled edge semantics)
+  //
+  // The warn fires iff: type === 'human' && src && alt == null && !decorative.
+  // @see Requirements: 5.4 (human + src requires alt), 5 AC 5 (agent ignores src),
+  //      9.2 (decorative applies aria-hidden)
+  // ============================================================================
+
+  describe('Alt Warning Behavior', () => {
+    let consoleSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+      consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+    });
+
+    afterEach(() => {
       consoleSpy.mockRestore();
     });
+
+    it('should warn with alt-first guidance when human avatar has src but no alt', async () => {
+      const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+      avatar.type = 'human';
+      avatar.src = 'https://example.com/profile.jpg';
+      document.body.appendChild(avatar);
+
+      await new Promise(resolve => setTimeout(resolve, 0));
+
+      expect(consoleSpy).toHaveBeenCalledTimes(1);
+      const message = consoleSpy.mock.calls[0][0] as string;
+      // Alt-first ordering: the message must lead with "add alt", with decorative as the
+      // deliberate exception — never readable as "hide the image to silence the warning".
+      expect(message).toContain('"alt" is required when "src" is provided');
+      expect(message).toContain('decorative');
+      expect(message.indexOf('alt description')).toBeLessThan(message.indexOf('decorative'));
+    });
+
+    it('should NOT warn when human avatar has an explicitly empty alt attribute', async () => {
