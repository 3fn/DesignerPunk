+    /**
+     * Settled edge semantics for the Req 5.4 development warning.
+     *
+     * Spec 126 (option O2, ratified 2026-07-09): warn iff the avatar is human type AND
+     * has src AND the alt attribute is absent AND decorative is false. Agent type never
+     * warns (Req 5 AC 5 — src is ignored, so no image renders); a decorative avatar never
+     * warns (Req 9.2 — aria-hidden makes alt text unannounceable, so demanding it is
+     * pointless work).
+     *
+     * @see Requirements: 5.4, 5 AC 5, 9.2
+     * @see .kiro/specs/126-avatar-decorative-warn/design-outline.md
+     */
+    describe('Warn edge semantics (Spec 126)', () => {
+      it('should warn for human + src + absent alt', async () => {
+        const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+        const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+        avatar.type = 'human';
+        avatar.src = 'https://example.com/profile.jpg';
+        document.body.appendChild(avatar);
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(consoleSpy).toHaveBeenCalledWith(expect.stringContaining('"alt" is required'));
+
+        consoleSpy.mockRestore();
+      });
+
+      it('should NOT warn for human + src + attribute-form empty alt', async () => {
+        // setAttribute is the only path to a genuine alt='' — the HTML decorative-image
+        // idiom, read here as declared intent.
+        const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+        const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+        avatar.type = 'human';
+        avatar.src = 'https://example.com/profile.jpg';
+        avatar.setAttribute('alt', '');
+        document.body.appendChild(avatar);
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(avatar.getAttribute('alt')).toBe('');
+        expect(consoleSpy).not.toHaveBeenCalled();
+
+        consoleSpy.mockRestore();
+      });
+
+      it('should warn for human + src + property-form empty alt (setter collapses to absent)', async () => {
+        // The alt setter removes the attribute on a falsy value, so `avatar.alt = ''`
+        // is indistinguishable from omitting alt and lands in the warn bucket. The
+        // collapse is invisible in render output (the img still gets alt="") but visible
+        // to the warn — pinned here so the two paths cannot silently converge.
+        const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+        const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+        avatar.type = 'human';
+        avatar.src = 'https://example.com/profile.jpg';
+        avatar.alt = '';
+        document.body.appendChild(avatar);
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(avatar.getAttribute('alt')).toBeNull();
+        expect(consoleSpy).toHaveBeenCalledWith(expect.stringContaining('"alt" is required'));
+
+        const img = avatar.shadowRoot?.querySelector('.avatar__image');
+        expect(img?.getAttribute('alt')).toBe('');
+
+        consoleSpy.mockRestore();
+      });
+
+      it('should NOT warn for human + src + decorative, and should hide it from screen readers', async () => {
+        // Co-asserts aria-hidden (Req 9.2) in the same fixture: the warn is suppressed
+        // BECAUSE the avatar is genuinely out of the accessibility tree, not incidentally.
+        const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+        const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+        avatar.type = 'human';
+        avatar.src = 'https://example.com/profile.jpg';
+        avatar.decorative = true;
+        document.body.appendChild(avatar);
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(consoleSpy).not.toHaveBeenCalled();
+
+        const container = avatar.shadowRoot?.querySelector('.avatar');
+        expect(container?.getAttribute('aria-hidden')).toBe('true');
+
+        consoleSpy.mockRestore();
+      });
+
+      it('should NOT warn for agent + src + absent alt (agent ignores src)', async () => {
+        const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+        const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+        avatar.type = 'agent';
+        avatar.src = 'https://example.com/profile.jpg';
+        document.body.appendChild(avatar);
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(consoleSpy).not.toHaveBeenCalled();
+
+        consoleSpy.mockRestore();
+      });
+
+      it('should NOT warn for agent + src + alt present (silencing is type-driven, not alt-driven)', async () => {
+        const consoleSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+
+        const avatar = document.createElement('avatar-base') as AvatarBaseElement;
+        avatar.type = 'agent';
+        avatar.src = 'https://example.com/profile.jpg';
+        avatar.alt = 'Agent avatar';
+        document.body.appendChild(avatar);
+
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(consoleSpy).not.toHaveBeenCalled();
+
+        consoleSpy.mockRestore();
+      });
+    });
   });
 
