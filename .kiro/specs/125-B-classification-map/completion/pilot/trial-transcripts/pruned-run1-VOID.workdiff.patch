diff --git a/src/components/core/Avatar-Base/contracts.yaml b/src/components/core/Avatar-Base/contracts.yaml
index 2ac76376..e4775d7b 100644
--- a/src/components/core/Avatar-Base/contracts.yaml
+++ b/src/components/core/Avatar-Base/contracts.yaml
@@ -163,17 +163,31 @@ contracts:
       - If alt prop provided: uses alt text
       - If no alt prop (iOS/Android): "User avatar" for human, "AI agent avatar" for agent
       - Web requires alt prop when src is provided
+
+      Web development warning — settled edge semantics (Spec 126, option O2, ratified
+      2026-07-09). Web warns iff ALL hold: type is human, src is present, the alt
+      attribute is absent, and decorative is false.
+      - Agent type never warns: agent ignores src entirely (042 Req 5 AC 5), so no image
+        renders and there is nothing to describe.
+      - decorative=true never warns: it is the supported non-informative signal and
+        applies aria-hidden (042 Req 9.2), so alt text would never be announced.
+      - The alt setter removes the attribute on a falsy value, so the property form
+        alt='' collapses to absent and warns; a genuine empty alt is reachable only via
+        setAttribute('alt', '') and is read as declared decorative intent.
+      - No native warn equivalent exists on iOS/Android; parity is out of scope.
     wcag: "1.1.1 Non-text Content"
     platforms: [web, ios, android]
     validation:
       - Alt text matches alt prop when provided
       - Default label used when no alt prop (native)
       - Accessible name present for non-decorative avatars
+      - Web warn fires only for human + src + absent alt + non-decorative
     test_approach: |
       - Render Avatar with alt="John Doe"
       - Verify accessible name is "John Doe"
       - Render Avatar without alt prop (native)
       - Verify default label is applied
+      - Web: assert the warn matrix (human/agent x alt absent/empty/present x decorative)
     required: true
 
   accessibility_color_contrast:
